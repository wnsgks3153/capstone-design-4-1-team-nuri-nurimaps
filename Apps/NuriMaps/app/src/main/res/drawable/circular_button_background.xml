<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E0E0E0"/> <!-- 눌렀을 때 약간 어두운 회색 -->
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/> <!-- 기본 흰색 배경 -->
            <stroke android:width="1dp" android:color="#CCCCCC"/> <!-- 가벼운 테두리 -->
        </shape>
    </item>
</selector>